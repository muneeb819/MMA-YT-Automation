# =============================================================================
# ShortForge AI — environment configuration
# Copy to `.env.local` (dev) / set in your host's dashboard (production).
# NEVER commit a populated .env. Never expose these values to the browser.
# =============================================================================

# --- Application mode ---------------------------------------------------------
# true  = Demo/Mock mode. No external API calls; synthetic script/voice/visuals,
#         but a REAL MP4 is still rendered with real FFmpeg. Clearly badged in UI.
# false = Live mode. Providers are used and failures surface as real errors.
MOCK_MODE=true

# When true, a signed-in user may pick per-user API keys in Settings.
# Keep false on multi-tenant deployments.
ALLOW_USER_PROVIDER_KEYS=false

# --- LLM (script, SEO, scene planning, research synthesis) --------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Voice (ElevenLabs) -------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Image / video generation (Replicate) ------------------------------------
REPLICATE_API_TOKEN=

# --- Managed render (Creatomate) — optional alternative to local FFmpeg ------
CREATOMATE_API_KEY=

# --- Object storage ----------------------------------------------------------
# Local filesystem driver is used when these are blank (dev only).
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Database ----------------------------------------------------------------
# Leave blank to use the embedded PGlite database (real Postgres, dev only).
# Set to a real Postgres URL in production.
DATABASE_URL=
# PGlite data directory (dev only).
PGLITE_DATA_DIR=.data/pglite

# --- Queue -------------------------------------------------------------------
# Leave blank to use the in-process worker (dev). Set Redis in production.
REDIS_URL=

# --- Auth --------------------------------------------------------------------
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Allow the demo passwordless sign-in button (dev/demo only). Auto-disabled in production.
ALLOW_DEMO_LOGIN=true

# Public origin used for absolute links + YouTube OAuth redirect.
NEXTAUTH_URL=http://localhost:4310
NEXTAUTH_SECRET=

# --- YouTube OAuth -----------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4310/api/youtube/callback

# --- Media rights / content safety -------------------------------------------
# Keys used to encrypt YouTube OAuth tokens at rest (32-byte hex or base64).
TOKEN_ENCRYPTION_KEY=

# --- Retention / cleanup -----------------------------------------------------
# Hours before failed-job temp files and render intermediates are removed.
CLEANUP_TEMP_AFTER_HOURS=24
# Days to retain finished project assets. 0 = keep forever.
ASSET_RETENTION_DAYS=0
