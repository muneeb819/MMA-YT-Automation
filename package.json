{
  "name": "shortforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "db:push": "tsx src/db/push.ts",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx src/worker/main.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sf:dev": "concurrently -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.44.7",
    "ffmpeg-static": "5.3.0",
    "ioredis": "^5.9.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.26",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
